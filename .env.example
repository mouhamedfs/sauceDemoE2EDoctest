# Variables d'environnement — chargées automatiquement via dotenv (playwright.config.ts).
# Compte de TEST dédié uniquement (jamais un compte production).
# Ce fichier est exclu du git (.gitignore) — .env.example sert de modèle versionné.

BASE_URL=https://www.saucedemo.com

# Utilisés par global-setup.ts à chaque `pnpm test` pour rafraîchir playwright/.auth/user.json.
# Pré-remplis par Doctest après Session Capture — sinon laisser vide (fallback sur le seed user.json).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Doctest Flakiness Observability — ingestion CI (optionnel)
# Console : https://app.doctest.dev/app/flakiness → entrer ce token pour voir les flaky
DOCTEST_PROJECT_TOKEN=sauceflacky
DOCTEST_API_URL=https://api.doctest.dev
